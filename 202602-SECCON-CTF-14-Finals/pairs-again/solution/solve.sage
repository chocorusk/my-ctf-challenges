# https://gist.github.com/maple3142/8933b70e6011043b65849314563fba55

# BLS12-381
# https://hackmd.io/@benjaminion/bls12-381
x = var("x")
q = 0x1A0111EA397FE69A4B1BA7B6434BACD764774B84F38512BF6730D2A0F6B0F6241EABFFFEB153FFFFB9FEFFFFFFFFAAAB
r = 0x73EDA753299D7D483339D80809A1D80553BDA402FFFE5BFEFFFFFFFF00000001
Fq = GF(q)
Fq2 = GF(q ^ 2, "i", x ^ 2 + 1)
i = Fq2.gen()
u6 = 1 / (1 + i)
b = 4


E1 = EllipticCurve(Fq, (0, b))
E2 = EllipticCurve(Fq2, (0, b / u6))
G1 = E1.lift_x(
    3685416753713387016781088315183077757961620795782546409894578378688607592378376318836054947676345821548104185464507
)
G2 = E2.lift_x(
    352701069587466618187139116011060144890029952792775240219908644239793785735715026873347600343865175952761926303160
    + i
    * 3059144344244213709971259814753781636986470325476647558659373206291635324768958432433509563104347017837885763365758
)
assert r * G1 == 0
assert r * G2 == 0


u, i = polygens(Fq, "u,i")
mod = ((1 + i) * u ^ 6 - 1).sylvester_matrix(i ^ 2 + 1, i).det().univariate_polynomial()
Fq12 = GF(q ^ 12, "u", mod)
u = Fq12.gen()
E3 = EllipticCurve(Fq12, [0, 4])
i_in_fq12 = Fq2.modulus().change_ring(ZZ)(polygen(Fq12)).roots(multiplicities=False)[1]
assert i_in_fq12**2 + 1 == 0


def fp2_to_fq12(el):
    return el.polynomial()(i_in_fq12)


G1x = E3(G1)
G2x = E3(u ^ 2 * fp2_to_fq12(G2[0]), u ^ 3 * fp2_to_fq12(G2[1]))
assert r * G1x == 0
assert r * G2x == 0

# ------------------------------

# https://github.com/sagemath/sage/blob/4015f9189b6aa95f46bb957e78d303f5fb20e77e/src/sage/schemes/elliptic_curves/ell_point.py#L1828
def _line_(self, R, Q):
    if self.is_zero() or R.is_zero():
        if self == R:
            return self.curve().base_field().one()
        if self.is_zero():
            return Q[0] - R[0]
        if R.is_zero():
            return Q[0] - self[0]
    elif self != R:
        if self[0] == R[0]:
            return Q[0] - self[0]
        else:
            l = (R[1] - self[1])/(R[0] - self[0])
            return Q[1] - self[1] - l * (Q[0] - self[0])
    else:
        a1, a2, a3, a4, a6 = self.curve().a_invariants()
        numerator = (3*self[0]**2 + 2*a2*self[0] + a4 - a1*self[1])
        denominator = (2*self[1] + a1*self[0] + a3)
        if denominator == 0:
            return Q[0] - self[0]
        else:
            l = numerator/denominator
            return Q[1] - self[1] - l * (Q[0] - self[0])

def _miller_(self, Q, n):
    one = self.curve().base_field().one()
    t = one
    V = self
    nbin = n.bits()
    i = n.nbits() - 2
    while i > -1:
        S = 2*V
        ell = _line_(V, V, Q)
        vee = _line_(S, -S, Q)
        t = (t**2)*(ell/vee)
        V = S
        if nbin[i] == 1:
            S = V+self
            ell = _line_(V, self, Q)
            vee = _line_(S, -S, Q)
            t = t*(ell/vee)
            V = S
        i = i-1
    return t

# ------------------------------

def pairing(P, Q, k):
    return (P._miller_(Q, k)) ^ ((q ^ 12 - 1) // r)

from ptrlib import *
# sock = Process(["sage", "chal.sage"])
sock = Socket("nc localhost 13520")

m = 1337 * r

k = 11
P = E1(3490715509599620757014219224891042458217362724161986979920253508027122910837732586055426507346867438668802183386979, 263717933183042481211907471272957902390808639416329260656514385772218419238902503396669143705143038367400411614672)
assert k*P == E1(0)

sock.sendlineafter("Px", str(P[0]))
sock.sendlineafter("Py", str(P[1]))

t = sage_eval(sock.recvlineafter("pairing(P, Q) = ").strip().decode(), locals={'u':u})

PR.<x1> = PolynomialRing(Fq12)
PR2.<y1> = PolynomialRing(PR)
K2 = PR2.fraction_field()
# print(K2(_miller_(m * P, (x1, y1), 11)))
# exit()
# y1^2 -> x1^3+4
tn = (x1^3+4)^4*y1 + (3131343316880482548138711243828489788744717141673219142961755935863746901538061849142438710245932419490867369137506*x1 + 781585876907975065539690604881526546272642348706832951368415954874717356858822453795308036773515541511218803244668)*(x1^3+4)^4 + (2052316236107522165371810403069383545496064644737874611539970851009418268670480490828713955040642352762066640635174*x1^2 + 1093291466041374601476012072332449991615939113066825024768761905010980557283890471266450143719588059468161977397103*x1 + 3717046592892707346211537246954329851161279845905691511198109918785346924339893146517605780188220728158326462498279)*(x1^3+4)^3*y1 + (3705380505868426505252294632339710750633397402933478687362996667596751788916232066375006594983611859448687452026636*x1^3 + 1330433564079602424215543037001444860164593166822190174876000751960951855370407978500618052929732288649106798810543*x1^2 + 2102054561941583148832865726689930847952965784512030247617297167506190467260852895939774158510997181971337177637919*x1 + 2127450338205249664199339088729847937442447856180375422889249780795595956817274608979907764134551843124269586951734)*(x1^3+4)^3 + (1445447727865688089344496197773862881178027996652425734387533979556501875925795544132980046832164867289463655239888*x1^4 + 2398483777598809694688006087060719713737609304497629834227770034235641339614225445367323401408169487772393952577072*x1^3 + 656043014874957754083612169483286406004703729063546364260811723473863631215051301328259433761008661437941584184514*x1^2 + 1500027771815950881746744247448968348752582111266965096324525409298074100623755612619031357575054561629644984765119*x1 + 3317201924239429748112810427962334192249014129213764321100570967464470421957124083087251439528332934312071256908947)*(x1^3+4)^2*y1 + (1080498343966624754668566207792915481183420286944533538684649406900424424611801691968299469928956714972303624319600*x1^5 + 217003870291109455158302816465779706703798351916394657293516292721351793575038651304273258095731645318984