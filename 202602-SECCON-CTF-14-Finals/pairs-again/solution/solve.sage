td = x1^8 + 2916671137159658203824147556735997467555593298039735518157927835707172046566516360749199076540172429286532485370336*x1^7 + 3294949206828446456954624335433338686507264058446140535418706989966295667591573466520603355527975463824521185101676*x1^6 + 174397373093310002507508710084141750066553502845089078927538726464733345196144228711561562351920680419747673298862*x1^5 + 251064237216459373739570084635566284800448869419503726339701560178227792158712906419650070755083933023698062145410*x1^4 + 1551687308327932369836134590873165681056906301104099608408030310720234318492809125531721462461937980395168027749730*x1^3 + 522332674880967119305652163142238658763926995233291352321105075637062092614374626593860573240293158132755695020275*x1^2 + 562997488437917801579615136932563240924287073887710978163652299197996604483223337046485137118798566838925652644886*x1 + 3613988397695779705505236149246241941469229918007458762801858788793637197918649186172415614649931299594543442617269

# (tn/td)^((q^12-1)/r)*t^k = 1

e = ((q^12-1)//r)%(q^12-1)
d = pow(e, -1, r)
t2 = (t^(-k))^d

g = Fq12.random_element()
while True:
    assert t2^((q^12-1)//r)==t^(-k)
    t2 *= g^r

    t0, t1 = (tn-td*t2).list()

    # t1*y1+t0=0
    # (-t0/t1)^2-(x1^3+4)=0
    f = t0^2-(x1^3+4)*t1^2

    try:
        xq = f.roots()[0][0]
        yq = -t0(x1=xq)/t1(x1=xq)
    except:
        continue
    assert yq^2==xq^3+4
    sock.sendlineafter("Qx: ", str(xq.list()))
    sock.sendlineafter("Qy: ", str(yq.list()))
    sock.interactive()
    break
